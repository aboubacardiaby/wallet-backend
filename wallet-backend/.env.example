DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/wallet_db
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: set this to the exact admin frontend origin, without a trailing slash.
# Example: CORS_ORIGINS=https://admin.example.com
ALLOW_SIMULATED_FUNDING=false
PORT=8080
OTP_PEPPER=change-this-pepper
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Card Payment Processor Service (Stripe integration)
CARD_PAYMENT_SERVICE_URL=http://localhost:5200
CARD_PAYMENT_SERVICE_TIMEOUT=30

# Talence Payments API (Stripe debit card processing)
TALENCE_PAYMENTS_API_URL=https://talence-payments-api-525776555218.us-central1.run.app/
TALENCE_PAYMENTS_API_TIMEOUT=30
TALENCE_PAYMENTS_API_VERIFY_SSL=true

# SMTP / Email sending (required for receipt and notification emails)
# Example using Gmail / SendGrid / Mailgun / AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=Kalipeh Wallet
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_ENABLED=true
